{
  "manifest_version": 3,
  "name": "browser-mcp controller",
  "version": "1.0.0",
  "description": "Lets the browser-mcp server control this Chrome window via CDP.",
  "permissions": ["debugger", "tabs", "storage"],
  "host_permissions": ["ws://127.0.0.1/*", "wss://127.0.0.1/*", "http://127.0.0.1/*"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "browser-mcp"
  }
}
